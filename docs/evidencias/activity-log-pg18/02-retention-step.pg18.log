CREATE TABLE public.purge_runs (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, job text, started_at timestamptz, finished_at timestamptz, rows bigint, skipped_restrict int NOT NULL DEFAULT 0, skipped_hold int NOT NULL DEFAULT 0, status text, error text);
CREATE TABLE
CREATE TABLE public.legal_holds (id bigint PRIMARY KEY, subject_type text, closed_at timestamptz);
CREATE TABLE
GRANT SELECT ON public.legal_holds TO casalivre_retention; GRANT INSERT ON public.purge_runs TO casalivre_retention;
GRANT
GRANT
SET ROLE casalivre_retention;
SET
CREATE FUNCTION audit.activity_retention_step(p_held_refs bytea[], p_dry_run boolean DEFAULT true)
RETURNS TABLE(leaf text, held bigint, dropped boolean)
LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp SET timezone = 'UTC' SET lock_timeout = '200ms' AS $$
DECLARE r record; v_held bigint := 0; v_t0 timestamptz := clock_timestamp();
BEGIN
  IF NOT pg_try_advisory_xact_lock(hashtext('activity_retention')) THEN RAISE EXCEPTION 'activity_retention already running'; END IF;
  IF p_held_refs IS NULL OR EXISTS (SELECT 1 FROM unnest(p_held_refs) x WHERE octet_length(x) IS DISTINCT FROM 32) THEN RAISE EXCEPTION 'bad held refs'; END IF;
  IF cardinality(p_held_refs) = 0 AND EXISTS (SELECT 1 FROM public.legal_holds WHERE closed_at IS NULL AND subject_type = 'user') THEN RAISE EXCEPTION 'open user holds but no refs'; END IF;
  IF EXISTS (SELECT 1 FROM audit.activity_log_security_default) OR EXISTS (SELECT 1 FROM audit.activity_log_other_default) THEN RAISE EXCEPTION 'DEFAULT partition not empty'; END IF;
  SELECT c.relname::text AS leaf, CASE p.relname WHEN 'activity_log_security' THEN interval '90 days' ELSE interval '14 days' END AS keep, c.reltuples
    INTO r
    FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid JOIN pg_class p ON p.oid = i.inhparent
   WHERE p.relnamespace = 'audit'::regnamespace AND p.relname IN ('activity_log_security','activity_log_other')
     AND c.relname ~ '_p\d{8}$'
     AND (to_date(substring(c.relname from '_p(\d{8})$'),'YYYYMMDD') + 1)::timestamp AT TIME ZONE 'UTC'
         <= now() - CASE p.relname WHEN 'activity_log_security' THEN interval '90 days' ELSE interval '14 days' END
   ORDER BY substring(c.relname from '_p(\d{8})$'), c.relname LIMIT 1;
  IF NOT FOUND THEN RETURN; END IF;
  IF p_dry_run THEN RETURN QUERY SELECT r.leaf, 0::bigint, false; RETURN; END IF;
  EXECUTE format('INSERT INTO audit.activity_log_held SELECT *, now() FROM audit.%I WHERE actor_ref = ANY($1) ON CONFLICT (id) DO NOTHING', r.leaf) USING p_held_refs;
  GET DIAGNOSTICS v_held = ROW_COUNT;
  EXECUTE format('DROP TABLE audit.%I', r.leaf);
  DELETE FROM audit.activity_log_held h WHERE h.actor_ref <> ALL (p_held_refs)
     AND h.created_at < now() - CASE h.retention_class WHEN 'security' THEN interval '90 days' ELSE interval '14 days' END;
  INSERT INTO public.purge_runs (job, started_at, finished_at, rows, skipped_hold, status)
  VALUES ('activity_retention', v_t0, clock_timestamp(), greatest(r.reltuples, 0)::bigint, v_held, 'ok');
  RETURN QUERY SELECT r.leaf, v_held, true;
END $$;
