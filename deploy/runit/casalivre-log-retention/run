#!/bin/sh
# Serviço runit: retenção diária de logs do CasaLivre (14 dias por padrão).
# Instalação (Void), passos completos no checklist de deploy:
#   sudo install -m 0755 deploy/runit/casalivre-alert \
#     deploy/runit/casalivre-svlogd deploy/runit/casalivre-finish /usr/local/sbin/
#   sudo cp -a deploy/runit/casalivre-log-retention /etc/sv/
#   sudo ln -s /etc/sv/casalivre-log-retention /var/service/
# conf opcional em /etc/sv/casalivre-log-retention/conf (0640, sem segredos):
#   APP_DIR=/srv/casalivre  APP_USER=casalivre  RETENTION_DAYS=14  PHP_BIN=/usr/bin/php
#   RESTART_DELAY=86400  ALERT_CMD=/usr/local/sbin/seu-pager
# Sucesso: roda a retenção e dorme 24h; o runit reinicia e repete no dia seguinte.
# Falha: sai com o código do PHP (não engole 1 nem 2). ./finish alerta na hora
# e só então espera RESTART_DELAY (padrão 86400), para não entrar em loop.
exec 2>&1
[ -r ./conf ] && . ./conf
APP_DIR="${APP_DIR:-/srv/casalivre}"
APP_USER="${APP_USER:-casalivre}"
RETENTION_DAYS="${RETENTION_DAYS:-14}"
PHP_BIN="${PHP_BIN:-php}"

cd "$APP_DIR" || exit 1
chpst -u "$APP_USER" "$PHP_BIN" scripts/log-retention.php "$RETENTION_DAYS"
status=$?
if [ "$status" -ne 0 ]; then
  exit "$status"
fi
exec chpst -u "$APP_USER" sleep 86400
exit 1
