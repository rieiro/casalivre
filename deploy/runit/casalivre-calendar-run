#!/bin/sh
# Calendar sync worker. The lease is a row in calendar_feeds. No Valkey credentials.
# Install (Void), with the other helpers:
#   sudo install -m 0755 deploy/runit/casalivre-calendar-run /usr/local/sbin/
# Copy deploy/runit/casalivre-calendar-worker to /etc/sv/. Prod runs N=2
# (a second copy of the service directory). Dev runs one.
# Optional ./conf (mode 0640, no secrets; the app reads .env):
#   APP_DIR=/srv/casalivre  APP_USER=casalivre  PHP_BIN=/usr/bin/php
# stdout and stderr go to the log service (svlogd). A line containing ALERT is
# paged from there. A non-zero exit is paged by ./finish; runit then restarts
# this process. The worker already sleeps 5-30s before exit on a lost DB.
# zend.exception_ignore_args: a stack trace must not include argument values.
# memory_limit=256M, same as the queue workers. RSS budget is 64 MB.
exec 2>&1
[ -r ./conf ] && . ./conf
APP_DIR="${APP_DIR:-/srv/casalivre}"
APP_USER="${APP_USER:-casalivre}"
PHP_BIN="${PHP_BIN:-php}"
cd "$APP_DIR" || exit 1
exec chpst -u "$APP_USER" "$PHP_BIN" -d zend.exception_ignore_args=1 -d memory_limit=256M scripts/calendar-worker.php
exit 1
