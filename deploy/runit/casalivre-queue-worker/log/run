#!/bin/sh
# svlogd capture for the queue worker, plus paging of ALERT lines.
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
bin=
if [ -n "${CASALIVRE_RUNIT_BIN:-}" ] && [ -x "${CASALIVRE_RUNIT_BIN}/casalivre-svlogd" ]; then
  bin="${CASALIVRE_RUNIT_BIN}/casalivre-svlogd"
elif [ -x /usr/local/sbin/casalivre-svlogd ]; then
  bin=/usr/local/sbin/casalivre-svlogd
elif [ -x "$here/../../casalivre-svlogd" ]; then
  bin="$here/../../casalivre-svlogd"
fi
if [ -z "$bin" ]; then
  echo "casalivre-queue-worker/log: install deploy/runit/casalivre-svlogd to /usr/local/sbin" >&2
  exit 1
fi
exec "$bin" casalivre-queue-worker /var/log/casalivre/queue-worker
