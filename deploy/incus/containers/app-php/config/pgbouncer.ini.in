; CasaLivre PgBouncer - session pooling until SET ROLE/session locks are refactored.
[databases]
casalivre = host=10.10.20.10 port=5432 dbname=casalivre

; Per-user caps so log/retention logins cannot starve the application pool.
[users]
cl_logw = max_user_connections=8
cl_retention_job = max_user_connections=2

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432

; Local PHP -> PgBouncer hop: MD5 avoids per-request SCRAM PBKDF2.
; The plaintext userlist lets PgBouncer keep server connections warm with
; SCRAM + TLS to db-pg.
auth_type = md5
auth_file = /etc/casalivre-pgbouncer/userlist.txt

pool_mode = session
max_client_conn = 200
default_pool_size = 32
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 3
max_db_connections = 60

server_idle_timeout = 600
server_lifetime = 3600
server_connect_timeout = 5
server_check_query = select 1
server_check_delay = 30
query_wait_timeout = 30

server_tls_sslmode = verify-ca
server_tls_ca_file = /etc/casalivre-pgbouncer/db-ca.crt
client_tls_sslmode = disable

tcp_keepalive = 1
tcp_keepidle = 60
tcp_keepintvl = 10
tcp_keepcnt = 3

admin_users = pgbouncer_admin
stats_users = pgbouncer_admin
ignore_startup_parameters = extra_float_digits
pidfile = /run/casalivre-pgbouncer/pgbouncer.pid
