# Pinned sources for the hardened nginx edge. The build fails closed if any of these checks fail.
#
# nginx: official release tarball from https://nginx.org/download/, verified with SHA256 before compile.
NGINX_VERSION="1.30.7"
NGINX_SHA256="2565b5c837050e958f70fb0f73c48e2bca4542ad349fd356f46fb0c72610bc6e"
#
# headers-more-nginx-module: pinned release tag and exact commit. build.sh clones the repository and
# refuses to continue unless `git rev-parse HEAD` matches HEADERS_MORE_COMMIT (a commit hash is a
# stronger, tamper-evident pin than a mutable source tarball).
HEADERS_MORE_VERSION="v0.42"
HEADERS_MORE_COMMIT="e30b10e0bb1cfb042d76ba3a865410ff95d65660"
HEADERS_MORE_URL="https://github.com/openresty/headers-more-nginx-module.git"
#
# Base image for the builder and production containers. Override with the ALPINE_IMAGE environment variable.
ALPINE_IMAGE="images:alpine/3.21"
