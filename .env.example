APP_URL=http://127.0.0.1:8080
PHP_BIN=/usr/bin/php
DB_DRIVER=sqlite
DB_DSN=
DB_USER=
DB_PASSWORD=
LOG_DRIVER=sqlite
LOG_MONGO_URI=
LOG_MONGO_DB=
# LOG_SALT — OBRIGATÓRIO. Sal secreto (>= 32 caracteres aleatórios) para HMAC de usuário,
# e-mail, user agent e URLs nos logs. NÃO há fallback para APP_KEY ou qualquer outra variável.
# Sem LOG_SALT: esses identificadores são omitidos dos logs, um aviso (sem dados) vai para
# error_log, e scripts/log-lookup.php se recusa a rodar. Trocar o valor quebra a correlação
# com registros antigos. Gere com: php -r 'echo bin2hex(random_bytes(32));'
LOG_SALT=
STRIPE_SECRET_KEY=
PAGARME_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_MAPS_API_KEY=

# CORS / sessão para frontend em outro servidor
# Lista explícita de origens permitidas, separadas por vírgula (sem '*', sem barra final)
# CORS_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com
CORS_ORIGINS=
# Lax (padrão, mesmo site) ou None (cross-site, exige HTTPS)
SESSION_SAMESITE=Lax

# php.ini recomendado em produção: zend.exception_ignore_args = On (o app também força via ini_set)

# E-mail (SMTP) — links de ativação e redefinição de senha (src/Mailer.php)
# SMTP_SECURE: starttls (padrão, porta 587) | tls (TLS implícito, porta 465) | none (só servidor local)
# O certificado do servidor é sempre verificado; SMTP_CA_FILE adiciona uma CA própria, se necessário.
# Sem SMTP_HOST: em APP_ENV=dev/local o link vai para storage/logs/mail-dev.log (0600); em produção nada é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_CA_FILE=
# SMTP_TIMEOUT=10
