# One queue per service directory (casalivre-mail-worker or casalivre-image-worker-N).
# Prod runs N image workers (cores minus one). Dev installs casalivre-image-worker-1 only.
[ -S "$CL_RUN/valkey.sock" ] || { sleep 0.2; exit 1; }
cd "$CL_REPO" || exit 1
name=$(basename "$(pwd)")
case $name in
  *mail*)
    queue=mail
    user=cl_mail
    secret=$CL_HOME/etc/valkey-mail.secret
    ;;
  *image*)
    queue=image
    user=cl_image
    secret=$CL_HOME/etc/valkey-image.secret
    ;;
  *)
    echo "queue-worker: ALERT unknown service $name" >&2
    exit 1
    ;;
esac
export VALKEY_USER=$user VALKEY_PASSWORD_FILE=$secret
# zend.exception_ignore_args: a stack trace must not include argument values (the script sets it too).
# memory_limit=256M: one image decode of 25 megapixels is about 100-125 MB.
exec php8.4 -d zend.exception_ignore_args=1 -d memory_limit=256M scripts/queue-worker.php "$queue" 2>&1
