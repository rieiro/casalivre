# Exporte no shell antes de provision/up/down para sobrescrever os defaults.
# Todos opcionais; os defaults vêm do UID (bloco de 10 portas por usuário).
#CL_HOME=$HOME/.casalivre-dev
#CL_PORT_HTTP=20000+(UID%4000)*10
#CL_PORT_PG=HTTP+1
#CL_PORT_VALKEY=HTTP+2
#CL_PORT_FPM=HTTP+3
#CL_ROOTFS=$CL_HOME/rootfs
#CL_CACHE=$CL_HOME/cache       # tarball e cache do xbps (fora do rootfs)
#CL_ROOTFS_TARBALL=/caminho/void-x86_64-musl-ROOTFS-20250202.tar.xz
